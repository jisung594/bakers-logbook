{
  "hosting": {
    "public": "dist/pinch-recipes/browser",
    "ignore": [
      "firebase.json",
      "/.*",
      "/node_modules/"
    ],
    "headers": [
      {
        "source": "/*.@(js|css|jpg|jpeg|gif|png|svg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=0,s-maxage=3600" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}